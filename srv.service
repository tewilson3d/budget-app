[Unit]
Description=Budget Tracker (shared budget: Go server + Vite/React PWA)
After=network.target

[Service]
Type=simple
User=exedev
Group=exedev
WorkingDirectory=/home/exedev/budget-app
# BUDGET_MEMBERS=you@example.com,partner@example.com lives here, outside the repo.
EnvironmentFile=/home/exedev/budget.env
ExecStart=/home/exedev/srv -listen :8000 -db /home/exedev/budget.sqlite3 -dist /home/exedev/budget-app/dist
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
