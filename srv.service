[Unit]
Description=Budget Tracker (static PWA, Vite/React build)
After=network.target

[Service]
Type=simple
User=exedev
Group=exedev
WorkingDirectory=/home/exedev/budget-app
ExecStart=/usr/bin/busybox httpd -f -p 8000 -h /home/exedev/budget-app/dist
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
